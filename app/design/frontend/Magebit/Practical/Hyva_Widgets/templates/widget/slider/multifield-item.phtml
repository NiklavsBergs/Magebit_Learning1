declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\HeroiconsOutline;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

// phpcs:disable Generic.Files.LineLength.TooLong

/** @var Template $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */

/** @var ViewModelRegistry $viewModels */

/** @var HeroiconsOutline $heroicons */
$heroicons = $viewModels->require(HeroiconsOutline::class);


// The item to render is set on the block before the template is rendered:
$column = $block->getData('item');

$buttonLabel = $column->getButton();
$buttonUrl = $column->getButtonUrl();
?>

<div class="flex flex-row items-center bg-[#003057] text-white p-10">

    <div class="w-1/2 pr-10">
        <h3 class="text-3xl mt-5"><?= $escaper->escapeHtml($column->getTitle()) ?></h3>
        <p class="mt-4 text-base">
            <?= /** @noEscape */ $column->getDescription(); ?>
        </p>
        <div class="mt-6 flex space-x-4">
        </div>

        <div class="mt-6 flex space-x-2">
            <button
                aria-label="<?= $escaper->escapeHtml(__('Previous')) ?>"
                class="px-6 py-2 bg-[#18466B] text-white font-bold hover:bg-[#1C4B6E]"
                :class="{ 'opacity-25 pointer-events-none' : active === 0 }"
                @click="window.dispatchEvent(new Event('prev-slide'))"
            >
                <?= $heroicons->chevronLeftHtml("w-3 h-3", 25, 25) ?>
            </button>

            <button
                aria-label="<?= $escaper->escapeHtml(__('Next')) ?>"
                class="px-6 py-2 bg-[#18466B] text-white font-bold hover:bg-[#1C4B6E]"
                :class="{ 'opacity-25 pointer-events-none' : active >= itemCount-pageSize }"
                @click="window.dispatchEvent(new Event('next-slide'))"
            >
                <?= $heroicons->chevronRightHtml("w-3 h-3", 25, 25) ?>
            </button>
        </div>
    </div>

    <div class="w-1/2">
        <div class="">
            <a href="<?= $escaper->escapeUrl($column->getButtonUrl()) ?>">
                <img src="<?= $escaper->escapeUrl($column->getThumbnail()); ?>"
                     alt="<?= $escaper->escapeHtmlAttr($column->getTitle()) ?>"
                     loading="lazy"
                     class="object-cover w-full h-auto shadow-lg"
                >
            </a>
        </div>
    </div>
</div>
