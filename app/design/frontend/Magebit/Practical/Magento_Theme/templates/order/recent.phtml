        return trim($output) && $block->getLayout()->getChildBlock('order-list-extra-action-buttons', $alias);
    }, ARRAY_FILTER_USE_BOTH);
}

$ordersArray = [];
foreach ($orders as $order) {
    $ordersArray[] = [
        'id' => $order->getId(),
        'date' => date('d.m.Y', strtotime($order->getCreatedAt())),
        'shipTo' => $order->getShippingAddress() ? $order->getShippingAddress()->getName() : '',
