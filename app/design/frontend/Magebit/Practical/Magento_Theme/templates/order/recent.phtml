        'status' => $order->getStatus(),
        'statusLabel' => $order->getStatusLabel(),
        'viewUrl' => $block->getViewUrl($order),
        'reorderUrl' => $block->getViewUrl($order),
    ];
}

$jsonOrders = json_encode($ordersArray);
