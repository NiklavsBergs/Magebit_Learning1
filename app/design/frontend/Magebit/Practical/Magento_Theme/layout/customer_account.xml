<?xml version="1.0"?>

<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="2columns-left" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="customer_account"/>
    <body>
        <referenceContainer name="page.top">
            <block class="Magento\Theme\Block\Html\Breadcrumbs" name="breadcrumbs" as="breadcrumbs">
                <action method="addCrumb">
                    <argument name="crumbName" xsi:type="string">home</argument>
                    <argument name="crumbInfo" xsi:type="array">
                        <item name="title" xsi:type="string">Sākums</item>
                        <item name="label" xsi:type="string">Sākums</item>
                        <item name="link" xsi:type="string">{{base url}}</item>
                    </argument>
                </action>
                <action method="addCrumb">
                    <argument name="crumbName" xsi:type="string">account</argument>
                    <argument name="crumbInfo" xsi:type="array">
                        <item name="title" xsi:type="string">Mans profils</item>
                        <item name="label" xsi:type="string">Mans profils</item>
                    </argument>
                </action>
            </block>
        </referenceContainer>

        <referenceBlock name="breadcrumbs">
            <action method="setTemplate">
                <argument name="template" xsi:type="string">Magento_Theme::html/breadcrumbs.phtml</argument>
            </action>
        </referenceBlock>

        <referenceBlock name="sidebar.main.account_nav">
            <action method="setTemplate">
                <argument name="template" xsi:type="string">Magento_Theme::html/collapsible.phtml</argument>
            </action>
        </referenceBlock>

        <referenceBlock name="customer-account-navigation-delimiter-2" remove="true" />

    </body>
</page>
